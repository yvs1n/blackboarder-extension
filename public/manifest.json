{
  "manifest_version": 3,
  "name": "Blackboarder: Academic Calendar & Deadline Companion",
  "version": "1.4.5",
  "description": "Extracts assignments, quizzes, and course deadlines from Blackboard Learn with calendar sync, syllabus weighting, and quick links.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Blackboarder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/popup/index.html?view=panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://elearning.sharjah.ac.ae/*",
        "*://blackboard.sharjah.ac.ae/*",
        "*://mylearn.sharjah.ac.ae/*",
        "https://*.blackboard.com/*",
        "https://*.sharjah.ac.ae/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "css": [
        "blackboard-dark.css"
      ],
      "js": [
        "blackboard-dark.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://blackboard.sharjah.ac.ae/*",
        "https://*.blackboard.com/*",
        "https://*.sharjah.ac.ae/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications",
    "sidePanel",
    "tabs",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://blackboard.sharjah.ac.ae/*",
    "https://*.blackboard.com/*",
    "https://*.sharjah.ac.ae/*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/*",
    "https://openrouter.ai/*",
    "https://api.ifm.ai/*",
    "https://blackboarder.pages.dev/*",
    "https://*.firebasedatabase.app/*",
    "https://*.firebaseio.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Open Blackboarder"
    }
  }
}
